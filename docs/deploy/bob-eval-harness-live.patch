+            if (this.config.logPrompts && extra.prompt)
+                rec.prompt = clipText(extra.prompt, MAX_RAW_CHARS);
+            this._emit('model_response', rec);
+        } catch { /* never throw */ }
+    }
+
+    noteParse(info = {}) {
+        try {
+            if (!this.enabled) return;
+            if (info.has_command && info.command_name) this._nextCommandId();
